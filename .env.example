# Copy to .env and fill in from https://app.alpaca.markets (Paper Trading -> API Keys)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
# Paper endpoint. Do NOT change this to the live URL until the paper
# evaluation passes its pre-registered criteria.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Set to 1 to log intended orders without submitting them
DRY_RUN=0
